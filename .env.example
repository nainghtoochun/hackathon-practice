# Server only. Never put this value in HTML, browser JavaScript, or Git.
GEMINI_API_KEY=
# Optional: an exact Flash model ID returned by your project's models.list.
# Tried first; temporary failure or retirement can fall back to other listed
# stable Flash models. Leave blank for automatic selection.
GEMINI_MODEL=
PORT=3000
# Local development defaults. Use an authenticated reverse proxy before sharing.
HOST=127.0.0.1
